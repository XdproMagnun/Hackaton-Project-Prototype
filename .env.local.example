# Copia este archivo a .env.local y rellena los valores.
# .env.local esta en .gitignore: nunca lo subas al repositorio.
#
# La configuracion web de Firebase (apiKey incluida) es publica por diseno:
# la seguridad real vive en firebase/firestore.rules y en App Check.
# NO pongas aqui un service account, una clave privada ni el admin SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = usa los emuladores locales (puertos de firebase/firebase.json).
# Dejalo en true mientras trabajamos en local; solo produccion lo pone en false.
VITE_FIREBASE_USE_EMULATORS=true
