{
  "name": "ubicarmen-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación móvil de Ubicarmen con Capacitor, separada de la versión web.",
  "scripts": {
    "copy:web": "node scripts/build-location.cjs && node scripts/copy-web-assets.cjs",
    "sync": "npm run copy:web && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
